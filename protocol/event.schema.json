{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr CLI adapter event",
  "type": "object",
  "properties": {
    "action": {"enum": ["session_start", "working", "blocked", "idle"]},
    "session_id": {"type": ["string", "null"]},
    "prompt": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]}
  },
  "required": ["action"]
}
